# Pinned versions — the declarative source of truth for the whole stack.
# Bump a version here, regenerate/re-apply, commit. Nothing below should
# reference `stable` or `latest` (checked 2026-09-14; re-check upstream
# release pages when bumping).
TALOS_VERSION=v1.14.0
ARGOCD_VERSION=v3.5.2
SEALED_SECRETS_VERSION=v0.39.1

# Homelab cluster identity.
CLUSTER_NAME=homelab
# Control-plane API VIP. Owned natively by Talos (see
# bootstrap/talos/controlplane-patch.yaml) — same IP kube-vip used to own.
CLUSTER_VIP=10.3.3.8
